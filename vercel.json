{
  "rewrites": [
    {
      "source": "/",
      "destination": "/api/render?path=/"
    },
    {
      "source": "/blink/:slug",
      "destination": "/api/render?path=/blink/:slug"
    },
    {
      "source": "/tech",
      "destination": "/api/render?path=/tech"
    },
    {
      "source": "/tech/kategoria/:slug",
      "destination": "/api/render?path=/tech/kategoria/:slug"
    },
    {
      "source": "/pozytywne",
      "destination": "/api/render?path=/pozytywne"
    },
    {
      "source": "/pozytywne/archiwum",
      "destination": "/api/render?path=/pozytywne/archiwum"
    },
    {
      "source": "/pozytywne/kategoria/:slug",
      "destination": "/api/render?path=/pozytywne/kategoria/:slug"
    },
    {
      "source": "/pozytywne/:category/:slug",
      "destination": "/api/render?path=/pozytywne/:category/:slug"
    },
    {
      "source": "/tech/:category/:slug",
      "destination": "/api/render?path=/tech/:category/:slug"
    },
    {
      "source": "/archiwum",
      "destination": "/api/render?path=/archiwum"
    },
    {
      "source": "/tagi",
      "destination": "/api/render?path=/tagi"
    },
    {
      "source": "/tag/:slug",
      "destination": "/api/render?path=/tag/:slug"
    },
    {
      "source": "/kategoria/:slug",
      "destination": "/api/render?path=/kategoria/:slug"
    },
    {
      "source": "/autorzy",
      "destination": "/api/render?path=/autorzy"
    },
    {
      "source": "/autor/:slug",
      "destination": "/api/render?path=/autor/:slug"
    },
    {
      "source": "/mistrzostwa-swiata-2026",
      "destination": "/api/render?path=/mistrzostwa-swiata-2026"
    },
    {
      "source": "/dzien/:date",
      "destination": "/api/render?path=/dzien/:date"
    },
    {
      "source": "/podsumowanie/:path*",
      "destination": "/api/render?path=/podsumowanie/:path*"
    },
    {
      "source": "/((?!assets/|api/|.*\\.[a-zA-Z0-9]+$).*)",
      "destination": "/api/render?path=/$1"
    }
  ],
  "headers": [
    {
      "source": "/sitemap.xml",
      "headers": [{ "key": "Content-Type", "value": "application/xml" }]
    },
    {
      "source": "/assets/(.*)",
      "headers": [{ "key": "Cache-Control", "value": "public, max-age=31536000, immutable" }]
    },
    {
      "source": "/index.html",
      "headers": [{ "key": "Cache-Control", "value": "no-store, no-cache, must-revalidate, max-age=0" }]
    },
    {
      "source": "/sw.js",
      "headers": [{ "key": "Cache-Control", "value": "public, max-age=0, must-revalidate" }]
    },
    {
      "source": "/((?!assets/).*)",
      "headers": [{ "key": "Cache-Control", "value": "no-store, no-cache, must-revalidate, max-age=0" }]
    }
  ],
  "redirects": [
    {
      "source": "/:path*",
      "has": [{ "type": "host", "value": "www.szortsy.pl" }],
      "destination": "https://szortsy.pl/:path*",
      "permanent": true
    },
    {
      "source": "/redakcja/:slug",
      "destination": "/autor/:slug",
      "permanent": true
    },
    {
      "source": "/redakcja",
      "destination": "/autorzy",
      "permanent": true
    },
    {
      "source": "/recki/kategoria/:slug",
      "destination": "/tech/kategoria/:slug",
      "permanent": true
    },
    {
      "source": "/recki/:category/:slug",
      "destination": "/tech/:category/:slug",
      "permanent": true
    },
    {
      "source": "/recki",
      "destination": "/tech",
      "permanent": true
    },
    {
      "source": "/sitemap.xml",
      "destination": "https://sitemap.szortsy.pl/",
      "permanent": true
    }
  ]
}
