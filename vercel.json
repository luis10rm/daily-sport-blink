{
  "rewrites": [
    {
      "source": "/(.*)",
      "destination": "/index.html"
    }
  ],
  "headers": [
    {
      "source": "/sitemap.xml",
      "headers": [{ "key": "Content-Type", "value": "application/xml" }]
    }
  ],
  "redirects": [
    {
      "source": "/:path*",
      "has": [{ "type": "host", "value": "www.szortsy.pl" }],
      "destination": "https://szortsy.pl/:path*",
      "permanent": true
    },
    {
      "source": "/redakcja/:slug",
      "destination": "/autor/:slug",
      "permanent": true
    },
    {
      "source": "/redakcja",
      "destination": "/autorzy",
      "permanent": true
    },
    {
      "source": "/sitemap.xml",
      "destination": "https://sitemap.szortsy.pl/",
      "permanent": true
    }
  ]
}

